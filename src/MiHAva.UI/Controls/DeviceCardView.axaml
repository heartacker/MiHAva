<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels"
             x:Class="MiHAva.UI.Controls.DeviceCardView"
             x:DataType="vm:DeviceCardViewModel">

    <UserControl.Styles>
        <!-- 卡片主体样式 -->
        <Style Selector="Border.miCard">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.miCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>
        <Style Selector="Border.miCard.offline">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- 开关按钮样式（米家经典大圆钮） -->
        <Style Selector="Button.miPowerBtn">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 开机：米家绿高亮 -->
        <Style Selector="Button.miPowerBtn.powerOn">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- 关机：低调浅灰底色 -->
        <Style Selector="Button.miPowerBtn.powerOff">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
        </Style>
    </UserControl.Styles>

    <!-- 卡片主体：点击空白区进入设备详情 -->
    <Border Classes="miCard"
            Classes.offline="{Binding !IsOnline}"
            Width="220" Height="140"
            Margin="6"
            Padding="14,12"
            BoxShadow="0 4 16 0 #12000000"
            Cursor="Hand"
            PointerPressed="OnCardPointerPressed">

        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- 顶栏：左上品类小图标 + 右上米家经典大圆形电源按钮 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                
                <!-- 品类圆形小底座与设备图标 -->
                <Border Grid.Column="0" 
                        Width="36" Height="36" 
                        CornerRadius="18"
                        Background="{DynamicResource SystemBaseLowColor}">
                    <TextBlock Text="💡" 
                               FontSize="16" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 房间名称微标签（靠右对齐开关左侧） -->
                <Border Grid.Column="1" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Background="{DynamicResource SystemChromeLowColor}" 
                        CornerRadius="4" 
                        Padding="6,2">
                    <TextBlock Text="{Binding RoomName}" 
                               FontSize="11" 
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Border>

                <!-- 米家经典圆形电源开关 -->
                <Button Grid.Column="2"
                        Classes="miPowerBtn"
                        Classes.powerOn="{Binding IsSwitchOn}"
                        Classes.powerOff="{Binding !IsSwitchOn}"
                        IsVisible="{Binding HasSwitch}"
                        IsEnabled="{Binding IsOnline}"
                        Command="{Binding ToggleSwitchCommand}"
                        ToolTip.Tip="开关设备">
                    <TextBlock Text="⏻" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 中间弹性占位 -->
            <Panel Grid.Row="1" />

            <!-- 底栏：设备名称 + 运行参数/状态文案 -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                
                <!-- 设备名称 (大字粗体) -->
                <TextBlock Grid.Row="0" 
                           Text="{Binding Name}" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Name}"/>

                <!-- 状态副标题（如：已开启 / 离线 / 正常运行） -->
                <Grid Grid.Row="1" Margin="0,3,0,0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- 在线且开启 -->
                        <TextBlock Text="已开启" 
                                   FontSize="12" 
                                   Foreground="#10B981" 
                                   IsVisible="{Binding IsSwitchOn}"/>
                        <!-- 在线且关闭 -->
                        <TextBlock Text="已关闭" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource SystemBaseMediumColor}" 
                                   IsVisible="{Binding !IsSwitchOn}"/>
                        <!-- 离线提示 -->
                        <TextBlock Text="· 离线" 
                                   FontSize="12" 
                                   Foreground="#EF4444" 
                                   IsVisible="{Binding !IsOnline}"/>
                    </StackPanel>

                    <!-- 操作中缓冲加载 Spinner -->
                    <ProgressBar Grid.Column="1" 
                                 Width="14" Height="14" 
                                 IsIndeterminate="True" 
                                 IsVisible="{Binding IsBusy}"/>
                </Grid>

            </Grid>

        </Grid>
    </Border>
</UserControl>
