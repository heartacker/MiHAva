<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels.Spec"
             xmlns:conv="using:MiHAva.UI.Converters"
             x:Class="MiHAva.UI.Controls.SpecPropertyControl"
             x:DataType="vm:SpecPropertyItemViewModel">

    <UserControl.Resources>
        <conv:SpecKindToBooleanConverter x:Key="IsBoolConv" TargetKind="Boolean"/>
        <conv:SpecKindToBooleanConverter x:Key="IsSliderConv" TargetKind="RangeSlider"/>
        <conv:SpecKindToBooleanConverter x:Key="IsComboConv" TargetKind="ValueList"/>
        <conv:SpecKindToBooleanConverter x:Key="IsReadOnlyConv" TargetKind="ReadOnlyText"/>
    </UserControl.Resources>

    <Border Padding="14,10"
            Margin="0,4"
            CornerRadius="8"
            Background="{DynamicResource SystemChromeLowColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
            
            <!-- 左侧：属性名与当前值简述 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Description}" 
                           FontSize="14" 
                           FontWeight="Medium"/>
                <TextBlock Text="{Binding DisplayText}" 
                           FontSize="12" 
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>

            <!-- 右侧：控件动态分发区 -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                
                <!-- 1. 布尔开关 ToggleSwitch -->
                <ToggleSwitch IsVisible="{Binding Kind, Converter={StaticResource IsBoolConv}}"
                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              IsEnabled="{Binding CanWrite}"
                              OnContent="" OffContent=""
                              Margin="0,-6,0,-6"/>

                <!-- 2. 滑块 Slider -->
                <StackPanel Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding Kind, Converter={StaticResource IsSliderConv}}">
                    <Slider Minimum="{Binding Minimum}"
                            Maximum="{Binding Maximum}"
                            SmallChange="{Binding Step}"
                            LargeChange="{Binding Step}"
                            Value="{Binding DoubleValue, Mode=TwoWay}"
                            IsEnabled="{Binding CanWrite}"
                            Width="150"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayText}" 
                               FontSize="12" 
                               Width="50"
                               VerticalAlignment="Center"
                               TextAlignment="Right"/>
                </StackPanel>

                <!-- 3. 下拉框 ComboBox -->
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          IsEnabled="{Binding CanWrite}"
                          IsVisible="{Binding Kind, Converter={StaticResource IsComboConv}}"
                          Width="130"/>

                <!-- 4. 只读标签 -->
                <Border IsVisible="{Binding Kind, Converter={StaticResource IsReadOnlyConv}}"
                        Background="{DynamicResource SystemBaseLowColor}"
                        CornerRadius="4"
                        Padding="8,4">
                    <TextBlock Text="{Binding DisplayText}" 
                               FontSize="12" 
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
