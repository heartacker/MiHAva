<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels"
             xmlns:ctrl="using:MiHAva.UI.Controls"
             x:Class="MiHAva.UI.Controls.SceneCategoryDetailControl"
             x:DataType="vm:SceneCategoryDetailViewModel">

    <Border Background="{DynamicResource SystemChromeMediumColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            CornerRadius="24"
            BoxShadow="0 16 48 0 #33000000"
            MaxWidth="920"
            MaxHeight="700"
            ClipToBounds="True">
        
        <Grid RowDefinitions="Auto,*">
            
            <!-- 顶栏：分类标题 + 全屋一键全开全关 + 关闭按钮 -->
            <Border Grid.Row="0"
                    Padding="24,18"
                    Background="{DynamicResource SystemChromeLowColor}"
                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- 左侧：图标与标题 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="44" Height="44" 
                                CornerRadius="22" 
                                Background="{DynamicResource SystemBaseLowColor}">
                            <TextBlock Text="{Binding Icon}" 
                                       FontSize="22" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" 
                                       FontSize="18" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Subtitle}" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间留白 -->
                    <Panel Grid.Column="1"/>

                    <!-- 右侧：全开/全关批量控制与关闭按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="全开" 
                                Command="{Binding TurnOnAllCommand}"
                                IsVisible="{Binding CategoryGroup.SupportsBatchSwitch}"
                                Padding="14,6"
                                CornerRadius="8"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12"/>
                        <Button Content="全关" 
                                Command="{Binding TurnOffAllCommand}"
                                IsVisible="{Binding CategoryGroup.SupportsBatchSwitch}"
                                Padding="14,6"
                                CornerRadius="8"
                                Background="{DynamicResource SystemBaseLowColor}"
                                Foreground="{DynamicResource SystemBaseHighColor}"
                                FontWeight="SemiBold"
                                FontSize="12"/>
                        
                        <!-- 关闭按钮 -->
                        <Button Content="✕" 
                                Command="{Binding CloseCommand}"
                                Width="32" Height="32"
                                CornerRadius="16"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="{DynamicResource SystemBaseLowColor}"
                                Foreground="{DynamicResource SystemBaseMediumColor}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主内容区：按房间分组列出所有属于该分类的具体设备卡片 -->
            <ScrollViewer Grid.Row="1" Padding="24,16">
                <ItemsControl ItemsSource="{Binding RoomGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneCategoryRoomGroup">
                            <StackPanel Margin="0,0,0,22" Spacing="10">
                                
                                <!-- 房间标题横条与房间一键控制 -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoomName}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"/>
                                        <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                CornerRadius="10" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 房间级全开/全关快捷控制 -->
                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                Spacing="6"
                                                IsVisible="{Binding SupportsBatchSwitch}">
                                        <Button Content="全开" 
                                                Command="{Binding TurnOnRoomCommand}"
                                                Padding="10,4"
                                                CornerRadius="6"
                                                FontSize="11"/>
                                        <Button Content="全关" 
                                                Command="{Binding TurnOffRoomCommand}"
                                                Padding="10,4"
                                                CornerRadius="6"
                                                FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 该房间内的设备卡片流 -->
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                            <ctrl:DeviceCardView/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
