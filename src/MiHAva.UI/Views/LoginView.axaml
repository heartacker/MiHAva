<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels"
             x:Class="MiHAva.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <!-- 居中卡片容器 -->
        <Border Width="400"
                Padding="32,28"
                CornerRadius="20"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                BoxShadow="0 10 32 0 #25000000">
            <StackPanel Spacing="18" HorizontalAlignment="Center">
                
                <!-- 头部标题与返回按钮栏 -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Content="‹ 返回"
                            Command="{Binding CancelCommand}"
                            Padding="8,4"
                            CornerRadius="8"
                            FontSize="12"
                            Background="Transparent"
                            Cursor="Hand"/>

                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="米家客户端" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="使用米家 APP 扫码登录" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource SystemBaseMediumColor}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右上角刷新按钮 -->
                    <Button Grid.Column="2"
                            Content="刷新"
                            Command="{Binding StartLoginCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            Padding="8,4"
                            CornerRadius="8"
                            FontSize="12"
                            Cursor="Hand"/>
                </Grid>

                <!-- 二维码显示区（带点击刷新与失效遮罩） -->
                <Border Width="220" Height="220"
                        CornerRadius="14"
                        Background="White"
                        Padding="12"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Grid>
                        <!-- 二维码图片 -->
                        <Image Source="{Binding QrBitmap}"
                               IsVisible="{Binding !IsLoading}"
                               Stretch="Uniform"/>

                        <!-- 加载等待状态 -->
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsLoading}"
                                     Width="50" Height="50"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                        <!-- 失效遮罩（点击即可刷新） -->
                        <Border Background="#E0000000"
                                CornerRadius="10"
                                IsVisible="{Binding IsExpired}">
                            <Button HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Command="{Binding StartLoginCommand}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock Text="🔄" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="二维码已失效" 
                                               Foreground="White" 
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <Border Background="#10B981" CornerRadius="6" Padding="12,5">
                                        <TextBlock Text="点击刷新" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- 底部提示信息与主动刷新入口 -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               HorizontalAlignment="Center"
                               MaxWidth="300"/>

                    <Button Content="刷新二维码"
                            Command="{Binding StartLoginCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            HorizontalAlignment="Center"
                            Padding="12,4"
                            FontSize="11"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- 已登录账号快速返回选择列表（多账号支持） -->
                <Border IsVisible="{Binding HasSavedAccounts}"
                        Margin="0,8,0,0"
                        Padding="12"
                        CornerRadius="12"
                        Background="{DynamicResource SystemChromeLowColor}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="或返回已登录的账号：" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>

                        <ItemsControl ItemsSource="{Binding SavedAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavedAccountItem">
                                    <Button HorizontalAlignment="Stretch"
                                            Margin="0,0,0,4"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            Background="{DynamicResource SystemChromeMediumColor}"
                                            Command="{Binding $parent[UserControl].((vm:LoginViewModel)DataContext).SelectExistingAccountCommand}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="👤" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="进入 ›" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
