<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels"
             xmlns:ctrl="using:MiHAva.UI.Controls"
             x:Class="MiHAva.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 房间横向胶囊按钮样式 -->
        <Style Selector="Button.roomPill">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.roomPill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.roomPill.selected">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 常用场景胶囊按钮样式 -->
        <Style Selector="Button.scenePill">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scenePill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
        </Style>

        <!-- 房间栏左右滚动轻量导航按钮 -->
        <Style Selector="Button.scrollNavBtn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scrollNavBtn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>

        <!-- 布局模式切换小按钮 (平铺 / 分类 / 分房间) -->
        <Style Selector="Button.layoutTabBtn">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.layoutTabBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
        </Style>
        <Style Selector="Button.layoutTabBtn.active">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 品类快速筛选胶囊按钮 (全部 / 灯 / 灯带 / 音响等) -->
        <Style Selector="Button.categoryPillBtn">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.categoryPillBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
        </Style>
        <Style Selector="Button.categoryPillBtn.selected">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 主界面纵向流动区 -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            
            <!-- 1. 顶栏：家庭下拉切换（Flyout 弹层） + 环境概览 + 紧凑搜索框与主题切换 -->
            <Border Grid.Row="0"
                    Padding="20,14,20,12"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- 左侧：家庭名称下拉展开（米家经典原生 Dropdown Flyout） -->
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <Button x:Name="HomeSwitcherButton"
                                Background="Transparent" 
                                Padding="0" 
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Width="280" 
                                            Padding="14"
                                            Background="{DynamicResource SystemChromeMediumColor}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="切换家庭与空间" 
                                                       FontSize="15" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource SystemBaseHighColor}"/>
                                            
                                            <!-- 家庭选项列表 -->
                                            <ItemsControl ItemsSource="{Binding AvailableHomes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:HomeCategoryItem">
                                                        <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,6"
                                                                Padding="12,10"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource SystemChromeLowColor}"
                                                                BorderBrush="{DynamicResource SystemBaseLowColor}"
                                                                BorderThickness="1"
                                                                Click="OnHomeItemClicked"
                                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectHomeCommand}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0" Text="🏠" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding RoomCount, StringFormat='{}{0} 个房间'}" 
                                                                               FontSize="11" 
                                                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="✓" 
                                                                           FontSize="14" 
                                                                           FontWeight="Bold" 
                                                                           Foreground="#10B981"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding CurrentHomeName}" 
                                           FontSize="20" 
                                           FontWeight="ExtraBold"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SystemBaseLowColor}"
                                        CornerRadius="8"
                                        Padding="5,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="▾" 
                                               FontSize="11" 
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        
                        <!-- 全屋环境概览与在线统计 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryText}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBlock Text="·" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseLowColor}"/>
                            <TextBlock Text="{Binding EnvironmentSummary}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：自适应搜索框 -->
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchKeyword, Mode=TwoWay}"
                             PlaceholderText="搜索设备、型号或房间..."
                             MaxWidth="260"
                             CornerRadius="16"
                             Padding="10,6"
                             Margin="12,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"/>

                    <!-- 右侧：功能按钮群 (主题模式 / 挂件 / 刷新 / 账号头像中心) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- 深色 / 浅色模式切换 -->
                        <Button Content="{Binding CurrentThemeIcon}" 
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="切换深色/浅色主题"
                                Padding="8,5"
                                CornerRadius="10"
                                FontSize="13"/>
                        <!-- 隐藏离线开关 -->
                        <ToggleButton IsChecked="{Binding HideOfflineDevices, Mode=TwoWay}"
                                      Padding="10,6"
                                      CornerRadius="10"
                                      FontSize="12"
                                      ToolTip.Tip="开启后隐藏所有离线设备，减少无效轮询">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="👁️‍🗨️" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="隐藏离线" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Content="桌面挂件" 
                                Command="{Binding ToggleDesktopBoardCommand}"
                                Padding="10,6"
                                CornerRadius="10"
                                FontSize="12"/>
                        <Button Command="{Binding OpenAboutCommand}"
                                ToolTip.Tip="关于 MiHAva (版本与项目信息)"
                                Padding="8,6"
                                CornerRadius="10"
                                FontSize="12">
                            <TextBlock Text="ℹ️" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                        <Button Content="刷新" 
                                Command="{Binding RefreshAllCommand}"
                                IsEnabled="{Binding !IsRefreshing}"
                                Padding="12,6"
                                CornerRadius="10"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12"/>

                        <!-- 账号信息与退出登录 / 切换账号菜单 -->
                        <Button Padding="8,5"
                                CornerRadius="10"
                                Background="{DynamicResource SystemChromeLowColor}"
                                BorderBrush="{DynamicResource SystemBaseLowColor}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="240" Padding="14" Background="{DynamicResource SystemChromeMediumColor}">
                                        <StackPanel Spacing="12">
                                            <!-- 用户基础信息 -->
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="36" Height="36" CornerRadius="18" Background="#10B981">
                                                    <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UserIdText}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="小米云端已连接" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Separator Height="1" Background="{DynamicResource SystemBaseLowColor}"/>

                                            <!-- 切换账号 / 登录新账号 -->
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SystemChromeLowColor}"
                                                    Command="{Binding SwitchAccountCommand}"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="🔄" FontSize="14"/>
                                                    <TextBlock Text="切换账号 / 登录新账号" FontSize="12" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 关于 MiHAva -->
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SystemChromeLowColor}"
                                                    Command="{Binding OpenAboutCommand}"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="ℹ️" FontSize="14"/>
                                                    <TextBlock Text="关于 MiHAva" FontSize="12" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- 退出登录 -->
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    CornerRadius="8"
                                                    Background="#15EF4444"
                                                    Foreground="#EF4444"
                                                    Command="{Binding LogoutCommand}"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="🚪" FontSize="14"/>
                                                    <TextBlock Text="退出当前登录" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="13"/>
                                <TextBlock Text="账号" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 全屋一键场景快捷横条 -->
            <Border Grid.Row="1" 
                    Padding="20,10" 
                    Background="{DynamicResource SystemChromeLowColor}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <!-- 一键全关 -->
                        <Button Classes="scenePill" Command="{Binding TurnOffAllLightsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="一键关灯" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="关闭全屋照明" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 离家模式 -->
                        <Button Classes="scenePill" Command="{Binding LeaveHomeSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🏠" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="离家模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="关闭非必须电器" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 回家模式 -->
                        <Button Classes="scenePill" Command="{Binding ArriveHomeSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✨" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="回家模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="开启客厅暖光与净化" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 一键全开 -->
                        <Button Classes="scenePill" Command="{Binding TurnOnAllSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="☀️" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="明亮模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="点亮主要区域照明" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. 横向无滚动条房间胶囊 Tab 栏（带左右微调导航按钮 + 支持鼠标拖拽与触控） -->
            <Border Grid.Row="2" 
                    Padding="14,10" 
                    BorderBrush="{DynamicResource SystemBaseLowColor}" 
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto">
                    
                    <!-- 房间列表与左右微调按钮行 -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        
                        <!-- 左移按钮 -->
                        <Button Grid.Column="0"
                                Classes="scrollNavBtn"
                                Click="OnScrollLeftClicked"
                                ToolTip.Tip="向左滚动房间列表"
                                Margin="0,0,8,0">
                            <TextBlock Text="‹" FontSize="18" FontWeight="Bold" Margin="0,-2,0,0"/>
                        </Button>

                        <!-- 房间胶囊按钮水平流动列表（隐藏滚动条，支持鼠标拖拽与触摸手势） -->
                        <ScrollViewer Grid.Column="1"
                                      x:Name="RoomsScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rooms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoomCategoryItem">
                                        <Button Classes="roomPill"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SwitchToRoomCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="13" 
                                                           FontWeight="SemiBold" 
                                                           VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                        CornerRadius="10" 
                                                        Padding="6,1" 
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceCount}" 
                                                               FontSize="10" 
                                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 右移按钮 -->
                        <Button Grid.Column="2"
                                Classes="scrollNavBtn"
                                Click="OnScrollRightClicked"
                                ToolTip.Tip="向右滚动房间列表"
                                Margin="8,0,0,0">
                            <TextBlock Text="›" FontSize="18" FontWeight="Bold" Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>

                    <!-- 小爱语音文字指令栏 -->
                    <Border Grid.Row="1" Margin="0,8,0,0">
                        <ctrl:XiaoAiBarControl DataContext="{Binding XiaoAiVm}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. 主内容展示区：不同 Tab 显示不同模式 -->
            <!-- A. 选定“场景” Tab 时：呈现分类汇总看板 (参考米家澎湃智联场景设计) -->
            <ctrl:SceneDashboardControl Grid.Row="3"
                                        IsVisible="{Binding IsSceneTabSelected}"/>

            <!-- B. 选定“全屋”或单个房间 Tab 时：呈现设备网格 -->
            <ScrollViewer Grid.Row="3" 
                          Padding="20,14"
                          IsVisible="{Binding !IsSceneTabSelected}">
                <StackPanel Spacing="14">
                    
                    <!-- 当前所选 Tab / 房间的标题与状态横条 -->
                    <Border Background="{DynamicResource SystemChromeLowColor}"
                            CornerRadius="14"
                            Padding="16,10"
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- 房间/Tab 标题与概况 -->
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTabTitle}" 
                                           FontSize="16" 
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentTabSubtitle}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            </StackPanel>

                            <!-- 右侧：摆放模式切换 (平铺 / 分类 / 分房间) + 设备数量统计 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{DynamicResource SystemChromeMediumColor}"
                                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="3">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- 平铺摆放 -->
                                        <Button Classes="layoutTabBtn"
                                                Classes.active="{Binding IsFlatLayout}"
                                                Command="{Binding SetFlatLayoutCommand}"
                                                ToolTip.Tip="平铺摆放当前所有设备">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="🔲" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="平铺" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 分类摆放 -->
                                        <Button Classes="layoutTabBtn"
                                                Classes.active="{Binding IsCategoryLayout}"
                                                Command="{Binding SetCategoryLayoutCommand}"
                                                ToolTip.Tip="按品类（灯、灯带、音箱、窗帘、开关等）分段分类呈现">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="📑" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="分类" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 分房间（仅在全屋视图下可见） -->
                                        <Button Classes="layoutTabBtn"
                                                Classes.active="{Binding IsRoomLayout}"
                                                Command="{Binding SetRoomLayoutCommand}"
                                                IsVisible="{Binding IsAllRoomSelected}"
                                                ToolTip.Tip="按房间分段摆放">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="🏠" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="分房间" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SystemBaseLowColor}" 
                                        CornerRadius="10" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredDevices.Count, StringFormat='共 {0} 件设备'}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 品类快速筛选胶囊条 (全部 / 💡 灯 / 🌈 灯带 / 🔊 音响 / 🪟 窗帘 / 🔌 开关 / 🌡️ 环境 / 🛡️ 安防) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Disabled"
                                  Padding="0,2,0,2">
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeviceCategoryFilterItem">
                                    <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectCategoryFilterCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="categoryPillBtn"
                                            Classes.selected="{Binding IsSelected}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource SystemBaseLowColor}" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 模式一：平铺摆放（所有匹配设备直接在统一网格中排列） -->
                    <ItemsControl ItemsSource="{Binding FilteredDevices}"
                                  IsVisible="{Binding IsFlatLayout}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                <ctrl:DeviceCardView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 模式二：分类摆放（按灯、灯带、音箱、窗帘、开关、环境传感等品类分段分组呈现） -->
                    <ItemsControl ItemsSource="{Binding CategorySections}"
                                  IsVisible="{Binding IsCategoryLayout}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategorySectionGroup">
                                <StackPanel Margin="0,0,0,18" Spacing="8">
                                    <!-- 品类分段标题栏 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                    CornerRadius="10" 
                                                    Padding="6,2" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SummaryText}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <Separator Grid.Column="1" Margin="14,0" Opacity="0.3"/>
                                    </Grid>

                                    <!-- 该分类下的设备卡片流 -->
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                                <ctrl:DeviceCardView/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 模式三：分房间摆放（全屋视图下按各个房间分段分组呈现） -->
                    <ItemsControl ItemsSource="{Binding RoomSections}"
                                  IsVisible="{Binding IsRoomLayout}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomSectionGroup">
                                <StackPanel Margin="0,0,0,18" Spacing="8">
                                    <!-- 房间分段标题栏 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoomName}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold"/>
                                            <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                    CornerRadius="10" 
                                                    Padding="6,2" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SummaryText}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <Separator Grid.Column="1" Margin="14,0" Opacity="0.3"/>
                                    </Grid>

                                    <!-- 该房间内的设备卡片流 -->
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                                <ctrl:DeviceCardView/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- 5. 全局分类房间明细弹窗遮罩（点击分类“›”后呼出，查看该品类每个房间内的详情） -->
        <Grid IsVisible="{Binding IsCategoryDetailOpen}">
            <Button Background="#66000000"
                    Command="{Binding CloseCategoryDetailCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderThickness="0"
                    Padding="0"/>
            <ctrl:SceneCategoryDetailControl DataContext="{Binding CategoryDetailVm}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Margin="32"/>
        </Grid>

        <!-- 6. 全局关于页面弹窗遮罩（仿 SourceGit 经典关于页设计） -->
        <Grid IsVisible="{Binding IsAboutOpen}">
            <Button Background="#66000000"
                    Command="{Binding CloseAboutCommand}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    BorderThickness="0"
                    Padding="0"/>
            <ctrl:AboutControl DataContext="{Binding AboutVm}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="32"/>
        </Grid>
    </Grid>
</UserControl>