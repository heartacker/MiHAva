<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiHAva.UI.ViewModels"
             xmlns:ctrl="using:MiHAva.UI.Controls"
             x:Class="MiHAva.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 房间横向胶囊按钮样式 -->
        <Style Selector="Button.roomPill">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.roomPill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.roomPill.selected">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 常用场景胶囊按钮样式 -->
        <Style Selector="Button.scenePill">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scenePill:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 主界面纵向流动区 -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            
            <!-- 1. 顶栏：家庭下拉切换（Flyout 弹层） + 环境概览 + 紧凑搜索框与主题切换 -->
            <Border Grid.Row="0"
                    Padding="20,14,20,12"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- 左侧：家庭名称下拉展开（米家经典原生 Dropdown Flyout） -->
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <Button Background="Transparent" 
                                Padding="0" 
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Width="280" 
                                            Padding="14"
                                            Background="{DynamicResource SystemChromeMediumColor}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="切换家庭与空间" 
                                                       FontSize="15" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource SystemBaseHighColor}"/>
                                            
                                            <!-- 家庭选项列表 -->
                                            <ItemsControl ItemsSource="{Binding AvailableHomes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:HomeCategoryItem">
                                                        <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,0,0,6"
                                                                Padding="12,10"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource SystemChromeLowColor}"
                                                                BorderBrush="{DynamicResource SystemBaseLowColor}"
                                                                BorderThickness="1"
                                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectHomeCommand}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0" Text="🏠" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding RoomCount, StringFormat='{}{0} 个房间'}" 
                                                                               FontSize="11" 
                                                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="✓" 
                                                                           FontSize="14" 
                                                                           FontWeight="Bold" 
                                                                           Foreground="#10B981"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding CurrentHomeName}" 
                                           FontSize="20" 
                                           FontWeight="ExtraBold"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SystemBaseLowColor}"
                                        CornerRadius="8"
                                        Padding="5,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="▾" 
                                               FontSize="11" 
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        
                        <!-- 全屋环境概览与在线统计 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryText}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <TextBlock Text="·" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseLowColor}"/>
                            <TextBlock Text="{Binding EnvironmentSummary}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 中间：自适应搜索框 -->
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchKeyword, Mode=TwoWay}"
                             PlaceholderText="搜索设备、型号或房间..."
                             MaxWidth="260"
                             CornerRadius="16"
                             Padding="10,6"
                             Margin="12,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"/>

                    <!-- 右侧：功能按钮群 (主题模式 / 挂件 / 刷新) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- 深色 / 浅色模式切换 -->
                        <Button Content="{Binding CurrentThemeIcon}" 
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="切换深色/浅色主题"
                                Padding="8,5"
                                CornerRadius="10"
                                FontSize="13"/>
                        <Button Content="桌面挂件" 
                                Command="{Binding ToggleDesktopBoardCommand}"
                                Padding="10,6"
                                CornerRadius="10"
                                FontSize="12"/>
                        <Button Content="刷新" 
                                Command="{Binding RefreshAllCommand}"
                                IsEnabled="{Binding !IsRefreshing}"
                                Padding="12,6"
                                CornerRadius="10"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 全屋一键场景快捷横条 -->
            <Border Grid.Row="1" 
                    Padding="20,10" 
                    Background="{DynamicResource SystemChromeLowColor}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <!-- 一键全关 -->
                        <Button Classes="scenePill" Command="{Binding TurnOffAllLightsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="一键关灯" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="关闭全屋照明" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 离家模式 -->
                        <Button Classes="scenePill" Command="{Binding LeaveHomeSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🏠" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="离家模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="关闭非必须电器" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 回家模式 -->
                        <Button Classes="scenePill" Command="{Binding ArriveHomeSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✨" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="回家模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="开启客厅暖光与净化" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- 一键全开 -->
                        <Button Classes="scenePill" Command="{Binding TurnOnAllSceneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="☀️" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="明亮模式" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="点亮主要区域照明" FontSize="10" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 3. 横向滚动吸顶房间胶囊 Tab 栏（每个 Tab 为独立 Button，100% 响应点击切换房间） -->
            <Border Grid.Row="2" 
                    Padding="20,10" 
                    BorderBrush="{DynamicResource SystemBaseLowColor}" 
                    BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto">
                    
                    <!-- 房间胶囊按钮水平流动列表 -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoomCategoryItem">
                                    <Button Classes="roomPill"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SwitchToRoomCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold" 
                                                       VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                    CornerRadius="10" 
                                                    Padding="6,1" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeviceCount}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 小爱语音文字指令栏 -->
                    <Border Grid.Row="1" Margin="0,8,0,0">
                        <ctrl:XiaoAiBarControl DataContext="{Binding XiaoAiVm}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. 主内容展示区：不同 Tab 显示不同房间对应的设备 -->
            <ScrollViewer Grid.Row="3" Padding="20,14">
                <StackPanel Spacing="14">
                    
                    <!-- 当前所选 Tab / 房间的标题与状态横条 -->
                    <Border Background="{DynamicResource SystemChromeLowColor}"
                            CornerRadius="14"
                            Padding="16,10"
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding CurrentTabTitle}" 
                                           FontSize="16" 
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentTabSubtitle}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            </StackPanel>

                            <Border Grid.Column="1" 
                                    Background="{DynamicResource SystemBaseLowColor}" 
                                    CornerRadius="10" 
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredDevices.Count, StringFormat='共 {0} 件设备'}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- A. 选定单个房间 Tab 时（或搜索状态下）：直接平铺该房间内的所有设备 -->
                    <ItemsControl ItemsSource="{Binding FilteredDevices}"
                                  IsVisible="{Binding !IsAllRoomSelected}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                <ctrl:DeviceCardView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- B. 选定“全部” Tab 时：按房间分段分组呈现 -->
                    <ItemsControl ItemsSource="{Binding RoomSections}"
                                  IsVisible="{Binding IsAllRoomSelected}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomSectionGroup">
                                <StackPanel Margin="0,0,0,18" Spacing="8">
                                    <!-- 房间分段标题栏 -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoomName}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold"/>
                                            <Border Background="{DynamicResource SystemBaseLowColor}" 
                                                    CornerRadius="10" 
                                                    Padding="6,2" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SummaryText}" 
                                                           FontSize="10" 
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <Separator Grid.Column="1" Margin="14,0" Opacity="0.3"/>
                                    </Grid>

                                    <!-- 该房间内的设备卡片流 -->
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeviceCardViewModel">
                                                <ctrl:DeviceCardView/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>