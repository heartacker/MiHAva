<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="AtomUI.Core" Version="6.2.13" />
    <PackageReference Include="AtomUI.Controls" Version="6.2.13" />
    <PackageReference Include="AtomUI.Controls.Shared" Version="6.2.13" />
    <PackageReference Include="AtomUI.Icons.AntDesign" Version="6.2.13" />
    <PackageReference Include="AtomUI.Fonts.AlibabaSans" Version="6.2.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiJia.Net\MiJia.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <Target BeforeTargets="GetAssemblyAttributes" Name="GenVersionInfo">
    <Exec Command="git describe --tags --always --dirty" ConsoleToMsBuild="True" IgnoreExitCode="true">
      <Output PropertyName="FriendlyVersion" TaskParameter="ConsoleOutput"/>
    </Exec>

    <ItemGroup>
      <AssemblyMetadata Include="FriendlyVersion" Value="$([System.String]::Copy('$(FriendlyVersion)').Trim())"/>
    </ItemGroup>
  </Target>

</Project>
