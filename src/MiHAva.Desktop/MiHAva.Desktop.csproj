<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Native AOT 发布与单文件优化配置 -->
    <PublishAot Condition="'$(DisableAOT)' != 'true'">true</PublishAot>
    <PublishTrimmed Condition="'$(DisableAOT)' == 'true'">true</PublishTrimmed>
    <PublishSingleFile Condition="'$(DisableAOT)' == 'true'">true</PublishSingleFile>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="AtomUI.Desktop.Controls" Version="6.2.13" />
    <PackageReference Include="AtomUI.Desktop.Controls.Extras" Version="6.2.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiHAva.UI\MiHAva.UI.csproj" />
  </ItemGroup>

  <Target BeforeTargets="GetAssemblyAttributes" Name="GenVersionInfo">
    <Exec Command="git describe --tags --always --dirty" ConsoleToMsBuild="True" IgnoreExitCode="true">
      <Output PropertyName="FriendlyVersion" TaskParameter="ConsoleOutput"/>
    </Exec>

    <ItemGroup>
      <AssemblyMetadata Include="FriendlyVersion" Value="$([System.String]::Copy('$(FriendlyVersion)').Trim())"/>
    </ItemGroup>
  </Target>

</Project>
