<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiHAva.UI.ViewModels"
        xmlns:ctrl="using:MiHAva.UI.Controls"
        x:Class="MiHAva.Desktop.Views.DesktopBoardWindow"
        x:DataType="vm:MainViewModel"
        Title="米家桌面挂件"
        Width="320" Height="480"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <!-- 半透明亚克力卡片容器 -->
    <Border Margin="12"
            CornerRadius="16"
            Background="{DynamicResource SystemChromeMediumColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #30000000"
            PointerPressed="OnPointerPressed">

        <Grid RowDefinitions="Auto,*">
            
            <!-- 挂件顶部控制条（拖拽手柄 + 标题 + 关闭按钮） -->
            <Grid Grid.Row="0" Margin="16,14,12,8" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="米家快捷挂件" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 关闭挂件按钮 -->
                <Button Grid.Column="1" 
                        Content="✕" 
                        Click="OnCloseClicked" 
                        Padding="6,2" 
                        CornerRadius="4"/>
            </Grid>

            <!-- 挂件主体卡片列表 -->
            <ScrollViewer Grid.Row="1" Padding="8,4">
                <ItemsControl ItemsSource="{Binding FilteredDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceCardViewModel">
                            <ctrl:DeviceCardView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
