<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiHAva.UI.ViewModels"
        xmlns:ctrl="using:MiHAva.UI.Controls"
        x:Class="MiHAva.Desktop.Views.TrayControlWindow"
        x:DataType="vm:MainViewModel"
        Title="米家快捷控制"
        Width="360" Height="500"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <Border Margin="10"
            CornerRadius="14"
            Background="{DynamicResource SystemChromeMediumColor}"
            BorderBrush="{DynamicResource SystemBaseLowColor}"
            BorderThickness="1"
            BoxShadow="0 8 28 0 #35000000">

        <Grid RowDefinitions="Auto,Auto,*,Auto">
            
            <!-- 顶部头栏 -->
            <Border Grid.Row="0" Padding="14,12" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentHomeName}" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新" 
                                Command="{Binding RefreshAllCommand}"
                                Padding="8,4" FontSize="11"/>
                        <Button Content="✕" 
                                Click="OnCloseClicked" 
                                Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 小爱语音/文字指令快捷条 -->
            <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
                <ctrl:XiaoAiBarControl DataContext="{Binding XiaoAiVm}"/>
            </Border>

            <!-- 主快捷设备卡片列表 -->
            <ScrollViewer Grid.Row="2" Padding="8,6">
                <ItemsControl ItemsSource="{Binding FilteredDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceCardViewModel">
                            <ctrl:DeviceCardView Margin="0,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部工具栏 -->
            <Border Grid.Row="3" Padding="14,10" Background="{DynamicResource SystemChromeLowColor}" CornerRadius="0,0,14,14">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" 
                            Content="打开主工作台" 
                            Click="OnOpenMainWindowClicked" 
                            HorizontalAlignment="Left"
                            Padding="12,6"/>
                    <Button Grid.Column="1" 
                            Content="退出应用" 
                            Click="OnExitClicked" 
                            HorizontalAlignment="Right"
                            Padding="12,6"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
